# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed — it's read by Django (tcg/settings.py) both under
# Docker Compose (via `env_file: .env`) and for the no-Docker `uv run` setup.

# --- Django -------------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value

# True for local dev (Django dev server + autoreload, static files served
# directly). False for any real deployment (gunicorn + WhiteNoise — see
# Dockerfile). Never True on a server reachable from the internet.
DEBUG=True

# Comma-separated list of hostnames the app is allowed to answer for.
# Required (non-empty) when DEBUG=False. Example: ALLOWED_HOSTS=packema.imt-ales.fr
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
# Used both by the `db` container and by Django. POSTGRES_HOST must be `db`
# under docker compose (compose.yaml overrides it) and `localhost` for `uv run`.
POSTGRES_DB=pack_ema
POSTGRES_USER=pack_ema
POSTGRES_PASSWORD=pack_ema
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Gameplay -------------------------------------------------------------
# Seconds between two packs. 600 = 10 min in prod; lower for manual testing.
PACK_COOLDOWN_SECONDS=600
